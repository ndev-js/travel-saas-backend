// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
  BILLING_ADMIN
}

model PlatformUser {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String       @map("password_hash")
  fullName     String?      @map("full_name")
  role         PlatformRole @default(SUPER_ADMIN)
  isActive     Boolean      @default(true) @map("is_active")
  lastLoginAt  DateTime?    @map("last_login_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@map("platform_users")
}

enum TenantPlan {
  free
  starter
  pro
  enterprice
}

enum TenantStatus {
  active
  suspended
  cancelled
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  subDomain String?      @map("sub_domain")
  plan      TenantPlan   @default(free)
  status    TenantStatus @default(active)
  logoUrl   String?      @map("logo_utl")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")
  users     User[]
  leads     Lead[]
}

enum UserRole {
  owner
  admin
  agent
}

model User {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  role         UserRole @default(agent)
  isActive     Boolean  @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  createdLeads  Lead[] @relation("LeadCreator")
  assignedLeads Lead[] @relation("LeadAssignee")

  @@unique([tenantId, email])
  @@map("users")
}

enum LeadStatus {
  new
  contacted
  qualified
  proposal_sent
  won
  lost
}

enum LeadSource {
  website
  referral
  social_media
  phone
  email
  walk_in
  other
}

// Matches the "Lead Type" dropdown of the create-lead form
enum LeadType {
  flight
  hotel
  visa
  tour
  umrah
  hajj
  insurance
  package
  other
}

// Matches the "Lead Handling" radio group of the create-lead form
enum LeadHandlingMode {
  self // Create and Takeover (Handle Myself)
  on_behalf // Create for Others
  transferred // Create and Transfer to Staff
}

model Lead {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  fullName         String  @map("full_name")
  email            String?
  phone            String?
  customerLocation String? @map("customer_location")

  leadType LeadType   @map("lead_type")
  source   LeadSource @default(other)
  status   LeadStatus @default(new)

  // Type-specific section of the form, keyed by leadType:
  //   flight    { from, to, tripType, cabinClass }
  //   hotel     { city, rating, rooms, boardBasis }
  //   visa      { country, visaType }
  //   tour      { destinations, needVisa, hotel, days }
  //   umrah     { route, makkahNights, madinaNights, package }
  //   hajj      { package, days }
  //   insurance { country, stay, vendor?, planName? }
  //   package   { requiredAt, serviceDetail }
  //   other     { serviceDetail }
  details Json @default("{}")

  // Departure / check-in / travel start / service date, and the optional return / check-out / travel end
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  adults    Int       @default(1)
  children  Int       @default(0)
  infants   Int       @default(0)
  remarks   String?

  handlingMode LeadHandlingMode @default(self) @map("handling_mode")
  createdById  String?          @map("created_by_id")
  createdBy    User?            @relation("LeadCreator", fields: [createdById], references: [id])
  assignedToId String?          @map("assigned_to_id")
  assignedTo   User?            @relation("LeadAssignee", fields: [assignedToId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId, status])
  @@index([tenantId, leadType])
  @@index([tenantId, assignedToId])
  @@map("leads")
}
