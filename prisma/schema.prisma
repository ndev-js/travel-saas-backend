generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
  BILLING_ADMIN
}

model PlatformUser {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String       @map("password_hash")
  fullName     String?      @map("full_name")
  role         PlatformRole @default(SUPER_ADMIN)
  isActive     Boolean      @default(true) @map("is_active")
  lastLoginAt  DateTime?    @map("last_login_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@map("platform_users")
}

enum TenantPlan {
  free
  starter
  pro
  enterprice
}

enum TenantStatus {
  active
  suspended
  cancelled
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  subDomain String?      @map("sub_domain")
  plan      TenantPlan   @default(free)
  status    TenantStatus @default(active)
  logoUrl   String?      @map("logo_utl")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")
  users     User[]
  leads     Lead[]
}

enum UserRole {
  owner
  admin
  agent
}

model User {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  role         UserRole @default(agent)
  isActive     Boolean  @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, email])
  @@map("users")
}
enum LeadType {
  FLIGHT
  HOTEL
  VISA
  TOUR
  UMRAH
  HAJJ
  INSURANCE
  PACKAGE
  OTHER
}

// Matches the "lead via" dropdown in step 2 of the create-lead form
enum LeadSource {
  WALK_IN
  REFERENCE
  PHONE_CALL
  WEBSITE
  SOCIAL_MEDIA
  ADVERTISEMENT
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum LeadHandlingMode {
  SELF
  ON_BEHALF
  TRANSFERRED
}

model Lead {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  fullName     String   @map("full_name")
  email        String?
  phoneNumber String?  @map("phone_number")
  createdAt    DateTime @default(now()) @map("created_at")
  leadType      String?  @map("lead_type")
  leadSource    String?  @map("lead_source")
  customerLocation String?  @map("customer_location")

  
}